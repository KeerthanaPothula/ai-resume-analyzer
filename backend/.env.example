# Copy this file to .env and fill in your values
# Never commit the actual .env file
# For Render deployment, set these in the Render dashboard instead (see render.yaml)

# Database — SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./resume.db
# DATABASE_URL=postgresql://user:password@localhost:5432/resumedb

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEBUG=False

# CORS — FRONTEND_URL is automatically added to the allow-list.
# For production, set FRONTEND_URL to your Vercel URL.
# To override the full list: ALLOWED_ORIGINS=["https://yourapp.vercel.app"]

# ── LLM / AI Feedback ─────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "gemini" or "openai" and supply the matching API key.
# Leave as "none" to fall back to deterministic template-based feedback (no cost).
LLM_PROVIDER=none

# Google Gemini — free tier available (recommended)
# Key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI — pay-per-use
# Key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Password Reset ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30

# ── SMTP Email (optional) ──────────────────────────────────────────────────────
# Without SMTP, reset links are printed to the terminal (dev mode).
# With SMTP, a branded HTML email is sent to the user.
#
# ── Gmail ─────────────────────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Generate an App Password: Google Account → Security → App passwords
#    (search "App passwords" if you don't see it)
# 3. Use the 16-character App Password below (spaces optional)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAILS_FROM_EMAIL=your.email@gmail.com
# EMAILS_FROM_NAME=Resume AI
#
# ── Outlook / Hotmail ─────────────────────────────────────────────────────────
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your.email@outlook.com
# SMTP_PASSWORD=your-password
# EMAILS_FROM_EMAIL=your.email@outlook.com
# EMAILS_FROM_NAME=Resume AI
#
# ── SendGrid SMTP relay (production-grade) ────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key
# EMAILS_FROM_EMAIL=noreply@yourdomain.com
# EMAILS_FROM_NAME=Resume AI
