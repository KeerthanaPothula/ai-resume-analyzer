# Copy this file to .env and fill in your values
# Never commit the actual .env file

# Database — SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./resume.db
# DATABASE_URL=postgresql://user:password@localhost:5432/resumedb

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEBUG=False

# ── LLM / AI Feedback ─────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "openai" or "gemini" and supply the matching API key.
# Leave as "none" to use deterministic template-based feedback (no API cost).
LLM_PROVIDER=none

# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash
