[flake8]
max-line-length = 120
extend-ignore =
    # slice notation spacing — conflicts with black
    E203,
    # line-break before binary operator — conflicts with black
    W503
exclude =
    venv,
    __pycache__,
    alembic/versions,
    .git
per-file-ignores =
    # test files freely import fixtures without using them directly
    tests/*: F401
    # HTML email templates are embedded strings — line-length cannot be fixed
    # without corrupting SVG path data or CSS style attributes sent in emails
    app/services/email.py: E501
