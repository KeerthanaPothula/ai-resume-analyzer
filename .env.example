# Root .env — used by docker-compose only
# For local dev without Docker, configure backend/.env instead
# For Render + Vercel deployment, configure env vars in their dashboards (see render.yaml)

# PostgreSQL (docker-compose)
POSTGRES_USER=resumeuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resumedb

# JWT — REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL — used in password-reset emails and auto-added to CORS allow-list
# Docker Compose local:
FRONTEND_URL=http://localhost:3000
# Production (set to your Vercel URL):
# FRONTEND_URL=https://your-app.vercel.app

# AI feedback (optional)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# SMTP email (optional — reset links print to terminal if not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# EMAILS_FROM_EMAIL=you@gmail.com
# EMAILS_FROM_NAME=RecruitAI

# Vercel frontend build variable — set in Vercel dashboard under Environment Variables
# VITE_API_URL=https://recruitai-backend.onrender.com
