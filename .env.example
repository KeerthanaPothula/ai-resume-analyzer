# Root .env — used by docker-compose only
# For local dev without Docker, configure backend/.env instead
# For Render + Vercel deployment, configure env vars in their dashboards (see render.yaml)

# ── PostgreSQL (docker-compose) ───────────────────────────────────────────────
POSTGRES_USER=resumeuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resumedb

# ── JWT — REQUIRED ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used in password-reset / verification emails and added to CORS allow-list.
# Docker Compose local:
FRONTEND_URL=http://localhost:3000
# Production — set to your Vercel URL:
# FRONTEND_URL=https://your-app.vercel.app

# ── AI Providers (at least one required for AI features) ─────────────────────
# ATS / Job Match routing:  Gemini → OpenAI → Groq
# Career Chat routing:      OpenAI → Gemini → Groq
# Providers without a key are skipped automatically.

# Google Gemini — https://aistudio.google.com (recommended primary)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI — https://platform.openai.com
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Groq — https://console.groq.com (free tier, good fallback)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Email — Resend (https://resend.com) ───────────────────────────────────────
# Free tier: 3,000 emails/month. Required for email verification and password reset.
# Without a key, verification/reset URLs are returned directly in API responses.
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@yourdomain.com    # must be on a verified Resend domain
# EMAILS_FROM_NAME=RecruitAI

# Set to "true" to return verify/reset URLs in API responses when email delivery fails.
# Recommended on Render free tier where outbound email can be unreliable.
# EMAIL_FALLBACK_ENABLED=true

# ── Embeddings (optional — requires ~500 MB RAM) ──────────────────────────────
# Enable sentence-transformers semantic similarity scoring.
# Keep false on Render free tier (512 MB limit).
# ENABLE_EMBEDDINGS=false

# ── Frontend build variable — set in Vercel dashboard ────────────────────────
# VITE_API_URL=https://recruitai-backend-f6pi.onrender.com
