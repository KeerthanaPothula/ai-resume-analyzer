# Normalize line endings to LF for all text files
* text=auto eol=lf

# Force LF for source files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf
*.env   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binary files — no line-ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.db    binary
*.pyc   binary
